---
http:
  middlewares:
{% for name, config in traefik_builtin_middlewares.items() %}
    {{ name }}:
{{ config | to_nice_yaml(indent=2) | indent(6, first=true) }}
{% endfor %}
{% for site in traefik_sites %}
{% if site.allowlist | default([]) | length > 0 %}
{% set seen = namespace(cidrs=[]) %}
    {{ site.name }}-allowlist:
      ipAllowList:
        sourceRange:
{% for group_name in site.allowlist %}
{% for cidr in (traefik_allowlist_groups[group_name] | default([])) %}
{% if cidr not in seen.cidrs %}
          - "{{ cidr }}"
{% set seen.cidrs = seen.cidrs + [cidr] %}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% endfor %}
